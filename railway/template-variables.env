# code-server 4.141.0 on Railway: every variable with its TEMPLATE value.
# ${{secret(N, ...)}} is generated once per deploy. Nothing needs to be filled in at deploy time.

### code-server (public, domain -> port 8080, health /healthz, volume /home/coder, start command in railway/start-command.txt)
PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
PORT=8080
DEFAULT_WORKSPACE=/home/coder/workspace
ENTRYPOINTD=/home/coder/.entrypoint.d
RAILWAY_RUN_UID=0

# --- Optional, add after deploy (not in the template) ---
# HASHED_PASSWORD=$argon2i$v=19$m=4096,t=3,p=1$...   # argon2 hash; wins over PASSWORD (then delete PASSWORD)
# GITHUB_TOKEN=                                       # pre-authenticates the GitHub extension / git over HTTPS
# CODE_SERVER_IDLE_TIMEOUT_SECONDS=3600               # exit after N idle seconds (pairs with Railway serverless sleep)
# CS_DISABLE_FILE_DOWNLOADS=true                      # block downloading files from the editor
# CS_DISABLE_PROXY=true                               # turn off the built-in /proxy/<port>/ port forwarding
# TZ=Asia/Kolkata                                     # timezone for the terminal
